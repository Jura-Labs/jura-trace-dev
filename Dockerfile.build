# Jura Trace — Reproducible Linux Build Environment
#
# Matches ubuntu-22.04 GitHub Actions runners for consistent builds.
# Produces Linux .deb and .AppImage artifacts.
#
# Usage:
#   docker build -f Dockerfile.build -t jura-build .
#   docker run --rm -v $(pwd)/dist:/dist jura-build

# Rust and Node come from their official images, pinned by digest, instead
# of `curl | sh` installers (OpenSSF Scorecard, Pinned-Dependencies). Both
# toolchains run on Ubuntu 22.04's glibc.
FROM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS rust
FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS node

# Pinned by digest (OpenSSF Scorecard, Pinned-Dependencies); the tag is kept
# for readers. Dependabot's docker updates move both together.
FROM ubuntu:25.10@sha256:7cc5e35f6567ee8c66d2abb4aab0fd866669e6207c237c3a8f0947a5c7f17092

ENV DEBIAN_FRONTEND=noninteractive

# Tauri v2 Linux dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        # Build essentials
        build-essential \
        curl \
        file \
        pkg-config \
        # Tauri v2 required libs
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libssl-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        # Additional deps
        libjavascriptcoregtk-4.1-dev \
        libsoup-3.0-dev \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Rust 1.96.1, from the rust image above
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
RUN rustup component add clippy rustfmt

# Node.js 20, from the node image above
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Tauri CLI
RUN cargo install tauri-cli --version "^2"

WORKDIR /build

# Copy manifests first for dependency caching
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock* src-tauri/
COPY ui/package.json ui/package-lock.json* ui/

# Install deps (cached layer)
RUN cd ui && npm ci --ignore-scripts
RUN cd src-tauri && cargo fetch

# Copy full source
COPY . .

# Build frontend then Tauri app
RUN cd ui && npm run build
RUN cd src-tauri && cargo tauri build

# Copy artifacts to /dist on completion
RUN mkdir -p /dist \
    && cp -r src-tauri/target/release/bundle/* /dist/ 2>/dev/null || true

CMD ["echo", "Build complete. Artifacts in /dist"]
