{
  "name": "jura-trace-ui",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "predev": "cargo run --manifest-path=../src-tauri/Cargo.toml --bin gen-detectors -- ..",
    "dev": "vite dev",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/lib/generated/expectedDetectors.ts')){process.exit(1)}\" || cargo run --manifest-path=../src-tauri/Cargo.toml --bin gen-detectors -- ..",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "autoprefixer": "^10.5.5",
    "happy-dom": "^20.14.0",
    "knip": "^6.34.0",
    "postcss": "^8.5.28",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1"
  },
  "type": "module",
  "overrides": {
    "esrap": "^2.2.11"
  }
}