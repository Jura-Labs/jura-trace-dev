# Jura Trace — Environment Variables
# Copy to .env and customise for your environment

# ===== Ollama (Local LLM) =====
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct

# ===== Python Sidecar (Phase 2+) =====
SIDECAR_PORT=8200
SIDECAR_LOG_LEVEL=INFO

# ===== Advisory Agents =====
ANTHROPIC_API_KEY=your-api-key-here

# ===== Application =====
# Data directory (default: ./data)
# JURA_DATA_DIR=/path/to/custom/data

# Log level: DEBUG, INFO, WARNING, ERROR
RUST_LOG=jura_trace=info
