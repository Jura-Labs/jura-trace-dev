# Jura Trace — Environment Variables
# Copy to .env and customise for your environment.
# None are required — all have sensible defaults.

# ── Sidecar Authentication ─────────────────────────────────────────
# API key for Tauri ↔ Python sidecar communication.
# Production builds auto-generate a 256-bit key if not set.
# Dev mode defaults to empty (no auth) for convenience.
# JURA_SIDECAR_KEY=

# ── Database Location ──────────────────────────────────────────────
# Override the default database path (highest priority).
# Also configurable via Settings UI or config.json.
# Default per platform:
#   macOS:   ~/Library/Application Support/Jura Trace/jura_archive.db
#   Windows: %APPDATA%\Jura Trace\jura_archive.db
#   Linux:   ~/.local/share/jura-trace/jura_archive.db
# JURA_DB_PATH=/path/to/custom/jura_archive.db

# ── Model Directory ────────────────────────────────────────────────
# Override models directory for the deepfake GBM classifier.
# Default: models/ relative to sidecar source or frozen binary.
# JURA_MODELS_DIR=/path/to/models

# ── Knowledge Base Directory ───────────────────────────────────────
# Override RAG knowledge base directory.
# Default: knowledge_base/ relative to sidecar source.
# JURA_KB_DIR=/path/to/knowledge_base

# ── Ollama (optional local LLM) ───────────────────────────────────
# Also configurable in Settings page UI.
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct

# ── Logging ────────────────────────────────────────────────────────
RUST_LOG=jura_trace=info
