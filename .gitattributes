# Enforce LF line endings for all text files.
# Prevents Windows CRLF issues in cross-platform builds.
* text=auto eol=lf

# Explicitly mark binary formats
*.png binary
*.ico binary
*.icns binary
*.dmg binary
*.msi binary
*.AppImage binary
*.woff binary
*.woff2 binary

# The macOS sidecar launcher is a compiled Mach-O binary built from
# src-tauri/sidecar-launcher/; diff it as binary.
src-tauri/binaries/jura-sidecar-aarch64-apple-darwin binary
