#!/bin/sh
# Jura Trace pre-commit hook — quick checks (< 30 seconds)
# Install: git config core.hooksPath .githooks

set -e

echo "Pre-commit: checking Rust formatting..."
(cd src-tauri && cargo fmt --check) || {
    echo "ERROR: cargo fmt check failed. Run 'cd src-tauri && cargo fmt' to fix."
    exit 1
}

# `--all-targets` catches test-fixture drift across lib + tests + bins + examples.
# Without it, bad integration test fixtures (e.g. the scheduler_handle field
# drift fixed at commit 80e2058) can slip through because `cargo check` alone
# only compiles the main crate targets.
echo "Pre-commit: checking Rust compilation (all targets)..."
(cd src-tauri && cargo check --all-targets 2>&1 | tail -1) || {
    echo "ERROR: cargo check --all-targets failed."
    exit 1
}

# `clippy -D warnings` catches code quality regressions before they hit main.
# The `--all-targets` flag ensures test code is also linted; `-D warnings`
# promotes warnings to errors so nothing new slips in silently.
echo "Pre-commit: running clippy..."
(cd src-tauri && cargo clippy --all-targets -- -D warnings 2>&1 | tail -1) || {
    echo "ERROR: cargo clippy found warnings. Fix them or add #[allow(...)] with a justification comment."
    exit 1
}

echo "Pre-commit: checking SvelteKit types..."
(cd ui && npx svelte-check --threshold error 2>&1 | tail -1) || {
    echo "ERROR: svelte-check found errors."
    exit 1
}

# Vitest unit tests for Svelte components.  Wired into the hook
# 2026-04-28 alongside the DetectorRow.test.ts landing — fast (~1s
# for the current suite) and catches component-level regressions
# the e2e suite would only catch via a full Playwright run.
echo "Pre-commit: running vitest unit tests..."
(cd ui && npm test --silent 2>&1 | tail -3) || {
    echo "ERROR: vitest unit tests failed.  Run 'cd ui && npm test' for detail."
    exit 1
}

echo "Pre-commit: all checks passed."
